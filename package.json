{
  "name": "playwright-api-bdd-starter",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "npm run cucumber",
    "cucumber": "cucumber-js --require-module @babel/register --require ./src/**/*.js --require ./steps/**/*.js --require ./features/steps/**/*.js --require ./features/steps/**/*.js --format progress --format json:reports/cucumber-report.json",
    "clean": "rm -rf reports",
    "report": "node scripts/generate-report.js",
    "lint": "eslint . --ext .js"
  },
  "dependencies": {
    "@cucumber/cucumber": "^9.0.0",
    "@playwright/test": "^1.40.0",
    "ajv": "^8.12.0",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@babel/register": "^7.22.0",
    "cucumber-html-reporter": "^7.2.0",
    "eslint": "^8.40.0"
  },
  "engines": {
    "node": ">=16"
  }
}
